# =============================================================================
# PMO System - Production Environment Variables
# =============================================================================
# Copy these variable names into Railway's "Variables" dashboard tab.
# NEVER commit actual secret values to version control.
#
# Generate AUTH_SECRET:
#   openssl rand -base64 32
#
# DATABASE_URL is provided automatically by Railway PostgreSQL plugin.
# =============================================================================

# --- Node Environment ---
NODE_ENV=production

# --- Database ---
# Provided automatically by Railway when PostgreSQL plugin is added.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@host:5432/railway

# --- Authentication ---
# REQUIRED: Minimum 32 characters. Generate with: openssl rand -base64 32
# Use a DIFFERENT value for staging and production.
AUTH_SECRET=<generate-with-openssl-rand-base64-32>

# The public URL of the deployed application (no trailing slash).
# Set to your Railway-provided subdomain or custom domain.
NEXTAUTH_URL=pmo-system-prj-production.up.railway.app
NEXT_PUBLIC_APP_URL=pmo-system-prj-production.up.railway.app

# --- LLM / OpenAI ---
# LLM_MODE controls which provider is used:
#   "real" - OpenAI API (requires OPENAI_API_KEY, incurs cost)
#   "mock" - Mock provider (no API key, no cost, returns placeholder text)
#   "auto" - Uses OpenAI if OPENAI_API_KEY is set, otherwise Mock
LLM_MODE=mock

# Required when LLM_MODE=real or LLM_MODE=auto with a valid key.
OPENAI_API_KEY=sk-proj-...

# OpenAI model identifier. gpt-4o-mini recommended for cost efficiency.
OPENAI_MODEL=gpt-4o-mini

# Legacy flag maintained for backward compatibility. Use LLM_MODE=real instead.
OPENAI_BILLING_ENABLED=true
