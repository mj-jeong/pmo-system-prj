// PMO System - Prisma Schema
// Multi-tenant SaaS for development organizations
// All domain entities MUST include organizationId for data isolation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// WeekDay - Day of week for scheduling
// =============================================================================

enum WeekDay {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

// =============================================================================
// Organization - Top-level tenant entity
// =============================================================================

model Organization {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  workingHoursStart Int?      // 0-23 (기본값 9시)
  workingHoursEnd   Int?      // 0-23 (기본값 18시)
  weeklyReportDay   WeekDay?  // 주간 리포트 기준 요일
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // Relations
  users              User[]
  roles              Role[]
  projects           Project[]
  projectUpdates     ProjectUpdate[]
  attendance         Attendance[]
  timeOffs           TimeOff[]
  agentRuns          AgentRun[]
  reports            Report[]
  membershipRequests MembershipRequest[]
  invitationTokens   InvitationToken[]
  statusHistories    ProjectStatusHistory[]
  auditLogs          AuditLog[]

  @@map("organizations")
}

// =============================================================================
// User - Organization member with role-based access
// =============================================================================

model User {
  id             String   @id @default(cuid())
  email          String
  name           String
  hashedPassword String
  organizationId String
  roleId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  // Relations
  organization     Organization         @relation(fields: [organizationId], references: [id])
  role             Role                 @relation(fields: [roleId], references: [id])
  projectUpdates   ProjectUpdate[]
  attendance       Attendance[]
  timeOffs         TimeOff[]
  agentRuns        AgentRun[]
  createdReports   Report[]             @relation("ReportCreatedBy")
  publishedReports Report[]             @relation("ReportPublishedBy")
  statusHistories  ProjectStatusHistory[]
  auditLogs        AuditLog[]

  // Indexes
  @@unique([email, organizationId])
  @@index([organizationId])
  @@index([roleId])
  @@map("users")
}

// =============================================================================
// Role - 3-tier role within an organization: OWNER > ADMIN > MEMBER
// =============================================================================

model Role {
  id             String   @id @default(cuid())
  name           RoleName
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization     Organization      @relation(fields: [organizationId], references: [id])
  users            User[]
  invitationTokens InvitationToken[]

  // Each organization has exactly one of each role type
  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("roles")
}

enum RoleName {
  OWNER
  ADMIN
  MEMBER
}

// =============================================================================
// Project - Organizational project with status tracking
// =============================================================================

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  status         ProjectStatus @default(IN_PROGRESS)
  startDate      DateTime?
  endDate        DateTime?
  progress       Int           @default(0) // 0-100 percentage
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  // Relations
  organization    Organization           @relation(fields: [organizationId], references: [id])
  updates         ProjectUpdate[]
  statusHistories ProjectStatusHistory[]

  // Indexes
  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status])
  @@map("projects")
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

// =============================================================================
// ProjectUpdate - Structured update log for AI-readiness
// Preserves chronological project status for future report generation
// =============================================================================

model ProjectUpdate {
  id             String   @id @default(cuid())
  content        String   // Free-text structured status: progress, blockers, plans
  projectId      String
  authorId       String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  project      Project      @relation(fields: [projectId], references: [id])
  author       User         @relation(fields: [authorId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  // Indexes
  @@index([organizationId])
  @@index([projectId])
  @@index([authorId])
  @@index([organizationId, projectId])
  @@index([organizationId, createdAt]) // For chronological report generation
  @@map("project_updates")
}

// =============================================================================
// ProjectStatusHistory - Tracks every project status change for auditability
// =============================================================================

model ProjectStatusHistory {
  id             String         @id @default(cuid())
  projectId      String
  organizationId String
  fromStatus     ProjectStatus? // null = 프로젝트 최초 생성 시
  toStatus       ProjectStatus
  changedById    String
  createdAt      DateTime       @default(now())

  // Relations
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
  changedBy    User         @relation(fields: [changedById], references: [id])

  // Indexes
  @@index([organizationId, projectId])
  @@index([projectId, createdAt])
  @@map("project_status_histories")
}

// =============================================================================
// Attendance - Daily attendance tracking per user
// Button-based workflow: Check-in button -> server timestamp -> Check-out button -> server timestamp
// =============================================================================

model Attendance {
  id             String           @id @default(cuid())
  userId         String
  date           DateTime         @db.Date
  checkIn        DateTime?        // Timestamp recorded when user clicks "Check-in" button (server-side)
  checkOut       DateTime?        // Timestamp recorded when user clicks "Check-out" button (server-side)
  status         AttendanceStatus @default(ABSENT)
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  // One attendance record per user per day per organization
  @@unique([userId, date, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, date])
  @@map("attendance")
}

enum AttendanceStatus {
  CHECKED_IN
  CHECKED_OUT
  ABSENT
}

// =============================================================================
// TimeOff - Leave request management with approval workflow
// =============================================================================

model TimeOff {
  id             String        @id @default(cuid())
  userId         String
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  type           TimeOffType
  status         TimeOffStatus @default(PENDING)
  reason         String?
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  // Indexes
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, status])
  @@index([organizationId, userId])
  @@map("time_offs")
}

enum TimeOffType {
  VACATION
  SICK
  PERSONAL
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
}

// =============================================================================
// Agent & Report Enums
// =============================================================================

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AgentStepName {
  PLAN
  COLLECT
  ANALYZE
  SUMMARIZE
  DRAFT
}

enum AgentStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}

enum DetailLevel {
  BRIEF
  STANDARD
  DETAILED
}

// =============================================================================
// AgentRun - Tracks a single agent execution lifecycle
// Records input parameters, status, timing, and links to generated report
// =============================================================================

model AgentRun {
  id             String         @id @default(cuid())
  organizationId String
  createdById    String
  status         AgentRunStatus @default(PENDING)
  inputParams    Json
  outputSummary  Json?
  errorMessage   String?
  startedAt      DateTime?
  finishedAt     DateTime?
  reportId       String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])
  report       Report?      @relation(fields: [reportId], references: [id])
  steps        AgentStep[]

  // Indexes
  @@index([organizationId])
  @@index([createdById])
  @@index([status])
  @@map("agent_runs")
}

// =============================================================================
// AgentStep - Individual step within an agent run pipeline
// Tracks each phase: PLAN -> COLLECT -> ANALYZE -> SUMMARIZE -> DRAFT
// =============================================================================

model AgentStep {
  id           String          @id @default(cuid())
  runId        String
  stepName     AgentStepName
  status       AgentStepStatus @default(PENDING)
  inputData    Json?
  outputData   Json?
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime        @default(now())

  // Relations
  run       AgentRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolCalls ToolCall[]

  // Indexes
  @@index([runId])
  @@index([stepName])
  @@map("agent_steps")
}

// =============================================================================
// ToolCall - Records individual tool invocations during agent steps
// Provides observability into data collection and external API calls
// =============================================================================

model ToolCall {
  id              String   @id @default(cuid())
  stepId          String
  toolName        String
  requestPayload  Json?
  responsePayload Json?
  latencyMs       Int?
  error           String?
  createdAt       DateTime @default(now())

  // Relations
  step AgentStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([stepId])
  @@index([toolName])
  @@map("tool_calls")
}

// =============================================================================
// MembershipRequest - 기존 조직 참여 요청 (Join Existing Organization)
// 사용자가 요청 제출 → Owner/Admin 승인/거절 → 승인 시 User 생성
// =============================================================================

model MembershipRequest {
  id             String        @id @default(cuid())
  email          String
  name           String
  hashedPassword String        // 요청 시 사용자가 설정, 승인 시 User 생성에 사용
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  status         RequestStatus @default(PENDING)
  message        String?       // 요청자 메모 (선택사항)
  reviewedBy     String?       // 승인/거절한 Admin/Owner userId
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([email])
  @@map("membership_requests")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// =============================================================================
// InvitationToken - 다중 초대 시스템 (이메일 / QR코드 / 링크)
// Admin/Owner가 토큰 생성 → 전달 방식 선택 → 사용자가 수락
// =============================================================================

model InvitationToken {
  id             String         @id @default(cuid())
  token          String         @unique
  email          String?        // 이메일 발송 방식만 입력 (QR/Link는 null)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  roleId         String
  role           Role           @relation(fields: [roleId], references: [id])
  deliveryMethod InviteDelivery @default(EMAIL)
  invitedBy      String         // 초대한 userId
  expiresAt      DateTime       // 기본 48시간 만료
  usedAt         DateTime?      // 수락 완료 시간
  usedByEmail    String?        // 실제 수락한 사용자 이메일 (QR/Link 방식용)
  createdAt      DateTime       @default(now())

  @@index([token])
  @@index([organizationId])
  @@map("invitation_tokens")
}

enum InviteDelivery {
  EMAIL
  QR_CODE
  LINK
}

// =============================================================================
// AuditLog - Immutable record of all significant admin/system actions
// Queryable by organizationId for compliance and debugging
// =============================================================================

enum AuditAction {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  PROJECT_STATUS_CHANGED
  REPORT_GENERATED
  REPORT_PUBLISHED
  MEMBER_INVITED
  MEMBER_APPROVED
  MEMBER_REJECTED
  MEMBER_REMOVED
  TIME_OFF_APPROVED
  TIME_OFF_REJECTED
  ORG_SETTINGS_UPDATED
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  actorId        String
  action         AuditAction
  entityType     String      // "Project" | "Report" | "User" | "TimeOff" | "Organization"
  entityId       String
  meta           Json?       // 변경 전후 값, 추가 컨텍스트 등
  createdAt      DateTime    @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User         @relation(fields: [actorId], references: [id])

  // Indexes
  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =============================================================================
// Report - Generated PMO report with draft/publish workflow
// Stores both markdown content and structured analysis data
// =============================================================================

model Report {
  id                String       @id @default(cuid())
  organizationId    String
  periodStart       DateTime
  periodEnd         DateTime
  projectIds        Json
  detailLevel       DetailLevel  @default(STANDARD)
  status            ReportStatus @default(DRAFT)
  draftMarkdown     String       @db.Text
  publishedMarkdown String?      @db.Text
  structuredData    Json?
  reasoningTrace    Json?        // { inputSummary, appliedRules: RuleResult[], riskScore }
  comparisonData    Json?        // { previousReportId, previousPeriod, deltas: {...} }
  createdById       String
  publishedAt       DateTime?
  publishedById     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation("ReportCreatedBy", fields: [createdById], references: [id])
  publishedBy  User?        @relation("ReportPublishedBy", fields: [publishedById], references: [id])
  agentRun     AgentRun?

  // Indexes
  @@index([organizationId])
  @@index([status])
  @@index([createdById])
  @@map("reports")
}
