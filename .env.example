# =============================================================================
# PMO System - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# -----------------------------------------------------------------------------
# Connection string for PostgreSQL database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pmo_system?schema=public"

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
# Secret used to sign/encrypt session tokens. Minimum 32 characters.
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-min-32-characters-here"

# The canonical URL of the NextAuth.js application.
# Used for callbacks and redirects.
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public-facing application URL. Exposed to the browser.
# SECURITY: Only NEXT_PUBLIC_ prefixed variables are exposed to the client.
# NEVER put secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# LLM Configuration (Agent Report Generation)
# -----------------------------------------------------------------------------

# LLM_MODE: Controls which LLM provider is used for report narrative generation.
#
# Available modes:
#   mock  - Always use Mock provider. No API key needed. $0 cost. Fast.
#   real  - Always use OpenAI provider. Requires OPENAI_API_KEY. ~$0.01-0.03/report.
#   auto  - (Default) Use OpenAI if API key available, fallback to Mock if not.
#
# Environment-specific recommendations:
#   CI/Test:    LLM_MODE=mock   (automatic: CI=true forces Mock regardless)
#   Local Dev:  LLM_MODE=auto   (default - Real if you provide key, Mock otherwise)
#   Staging:    LLM_MODE=real   (validate Real LLM output before production)
#   Production: LLM_MODE=real   (real AI narratives for production reports)
#
# NOTE: CI=true (set by GitHub Actions, GitLab CI, etc.) ALWAYS forces Mock mode
# regardless of LLM_MODE setting. This prevents accidental API costs in CI.
LLM_MODE=auto

# OpenAI API key for report narrative generation.
# Get your key at: https://platform.openai.com/api-keys
#
# When required:
#   - LLM_MODE=real  (mandatory - fails to start without key)
#   - LLM_MODE=auto  (optional - enables Real mode, Mock fallback without key)
#   - LLM_MODE=mock  (not needed - ignored even if present)
OPENAI_API_KEY=

# OpenAI model to use for report generation.
# Default: gpt-4o-mini (cost-effective). Alternative: gpt-4o (higher quality).
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Invitation System
# -----------------------------------------------------------------------------

# Resend API key for sending invitation emails.
# Required only when using EMAIL delivery method for member invitations.
# Sign up at: https://resend.com (free tier: 3,000 emails/month)
RESEND_API_KEY=

# How long invitation tokens remain valid (in hours). Default: 48 hours.
# QR code and link invitations also use this expiry.
INVITATION_EXPIRE_HOURS=48

# OPENAI_BILLING_ENABLED (LEGACY - use LLM_MODE instead)
# Maintained for backward compatibility with earlier configuration.
# If LLM_MODE is set, it takes precedence over this flag.
#   false (default) = equivalent to LLM_MODE=mock
#   true            = equivalent to LLM_MODE=real
# OPENAI_BILLING_ENABLED=false
